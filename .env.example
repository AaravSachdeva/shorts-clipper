# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai, gemini, or ollama (fully offline)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base      # tiny/base/small/medium; small or medium if time allows
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# Ollama (LLM_PROVIDER=ollama). `--profile cpu-slow` sets sensible values.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b         # ~5 GB; qwen3:14b (~9 GB) for better picks on 16 GB RAM
OLLAMA_NUM_CTX=16384          # Ollama's default is tiny and silently truncates prompts
OLLAMA_TIMEOUT=3600           # seconds per call; CPU inference is slow
OLLAMA_KEEP_ALIVE=10m

# Clip selection
HIGHLIGHT_CHUNK_SECONDS=1200  # 600 by default when LLM_PROVIDER=ollama
TARGET_LENGTH=medium          # short (15-35s) / medium (20-60s) / long (45-90s)
HIGHLIGHT_RERANK=true
HIGHLIGHT_EXAMPLES=           # research/out/top.jsonl from research/benchmark.py

# Rendering
CAPTIONS=true
CAPTION_FONT=Inter ExtraBold  # any installed bold font, e.g. "Arial Black", "Montserrat ExtraBold"
CAPTION_HIGHLIGHT=#FFD400
HOOK_OVERLAY=true
CROP_BOTTOM_PCT=0             # e.g. 12 to remove a burned-in ticker/chat bar
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
TARGET_LUFS=-14
